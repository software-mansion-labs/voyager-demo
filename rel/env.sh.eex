#!/bin/sh

# Voyager Station runs as a *named* distributed node with a known cookie, because
# the whole point of the booth is that Voyager attaches to it from a laptop in
# the room. Distribution ports stay closed on the box: Voyager reaches it over
# an SSH tunnel with a proxied EPMD, which is itself one of the features being
# demonstrated. Use a loopback host - station@127.0.0.1 - so the tunnelled
# connection resolves to the same name the node registered under.
#
# Both values are deliberately required rather than defaulted. A station that
# quietly came up unnamed would look perfect on the television and be invisible
# to the laptop, which is the one failure nobody notices until the doors open.

if [ -z "${STATION_NODE_NAME}" ]; then
  echo "STATION_NODE_NAME is not set (for example: station@127.0.0.1)" >&2
  exit 1
fi

if [ -z "${STATION_COOKIE}" ]; then
  echo "STATION_COOKIE is not set" >&2
  exit 1
fi

export RELEASE_DISTRIBUTION=name
export RELEASE_NODE="${STATION_NODE_NAME}"
export RELEASE_COOKIE="${STATION_COOKIE}"

# In a container the distribution port has to be published, so pin it. Only for
# the node itself: `remote` and `rpc` start a second node that must pick its own.
if [ -n "${STATION_DIST_PORT}" ]; then
  case "${RELEASE_COMMAND}" in
    start|start_iex|daemon|daemon_iex)
      export ERL_AFLAGS="-kernel inet_dist_listen_min ${STATION_DIST_PORT} inet_dist_listen_max ${STATION_DIST_PORT}"
      ;;
  esac
fi

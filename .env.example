# Public hostname the phones will reach (goes into the QR code too).
PHX_HOST=station.example.com
# Host port to publish the app on.
PORT=4000
# Host port for EPMD. Change when the host runs its own Erlang (4369 taken).
EPMD_PORT=4369

# Generate each with: mix phx.gen.secret  (or: openssl rand -base64 48)
SECRET_KEY_BASE=
STATION_OPS_TOKEN=
STATION_OPS_PASSWORD=
STATION_OPS_USERNAME=ops

# Erlang cookie Voyager uses to attach. Any string, keep it private.
STATION_COOKIE=

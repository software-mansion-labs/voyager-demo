# Copy to deploy/station.env for docker compose, or to /etc/station.env for the
# systemd unit. Fill it in, chmod 600.
#
#   SECRET_KEY_BASE        mix phx.gen.secret
#   STATION_OPS_TOKEN      mix phx.gen.secret 32
#   STATION_OPS_PASSWORD   something the booth staff can type on a phone
#   STATION_COOKIE         dedicated to this conference, rotated after it

# The name on the QR code. STATION_DOMAIN is what Caddy answers on and PHX_HOST
# is what the station believes it is called: the same name, or LiveView rejects
# every phone's websocket as a foreign origin.
STATION_DOMAIN=voy1.example.dev
PHX_HOST=voy1.example.dev
PORT=4000

SECRET_KEY_BASE=
STATION_OPS_TOKEN=
STATION_OPS_PASSWORD=
STATION_OPS_USERNAME=ops

# Named node with a known cookie, or Voyager has nothing to attach to. Loopback
# on purpose: the tunnel resolves to the same name the node registered under.
STATION_NODE_NAME=station@127.0.0.1
STATION_COOKIE=

# The one file that has to survive a redeploy. Under Docker this path is the
# station-data volume, so it survives the image being rebuilt too.
STATION_LEADERBOARD_PATH=/var/lib/station/leaderboard.ets

# The release wants somewhere to unpack; the unit gives it a private /tmp.
RELEASE_TMP=/tmp

# Only when the QR code should point somewhere other than PHX_HOST.
# STATION_DOCK_URL=https://voy1.example.dev

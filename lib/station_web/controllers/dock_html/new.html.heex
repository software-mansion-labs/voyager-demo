<Sprites.defs />
<Layouts.flash_group flash={@flash} />

<div class="mx-auto flex min-h-screen w-full max-w-xl select-none flex-col gap-6 px-4 py-8">
  <header class="flex items-center gap-4">
    <Sprites.voyager_logo class="h-8" />
    <h1 class="font-pixel text-lg text-primary">STATION</h1>
  </header>

  <div :if={@error} class="pixel-panel border-error/60 p-3 font-pixel text-[10px] text-error">
    {@error}
  </div>

  <.form for={@form} action={~p"/"} method="post" id="dock-form" class="flex flex-col gap-6">
    <section class="pixel-panel p-4">
      <label for="ship_name" class="font-pixel text-[10px] text-primary">SHIP NAME</label>
      <input
        type="text"
        id="ship_name"
        name="ship[name]"
        value={@form[:name].value}
        maxlength={Station.ShipNames.max_length()}
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        required
        placeholder="Millennium Falcon"
        class="mt-2 w-full border-2 border-base-300 bg-base-300 px-3 py-3 font-mono text-base text-base-content outline-none focus:border-primary"
      />
    </section>

    <section class="flex flex-col gap-3">
      <span class="font-pixel text-[10px] text-primary">CARGO TYPE</span>

      <div class="grid grid-cols-2 gap-3">
        <label :for={cargo <- @cargo_types} class="cursor-pointer">
          <input
            type="radio"
            name="ship[cargo]"
            value={cargo.value}
            checked={to_string(@form[:cargo].value) == cargo.value}
            required
            class="peer sr-only"
          />
          <div class={[
            "pixel-panel flex h-full flex-col gap-2 p-3 transition-colors",
            "hover:border-base-content/30",
            "peer-checked:border-primary peer-checked:bg-base-100",
            "peer-focus-visible:border-primary"
          ]}>
            <div class="flex items-center gap-2">
              <Sprites.crate_small class={["size-7", Sprites.cargo_color(cargo.value)]} />
              <span class="font-pixel text-[10px] leading-tight">{cargo.label}</span>
            </div>
            <dl class="mt-auto grid grid-cols-2 gap-x-2 font-mono text-[10px] text-base-content/45">
              <dt>size</dt>
              <dd class="text-right">{format_bytes(cargo.bytes)}</dd>
              <dt>checks</dt>
              <dd class="text-right">{format_count(cargo.rounds)}</dd>
            </dl>
          </div>
        </label>
      </div>
    </section>

    <button
      type="submit"
      id="dock-submit"
      class="pixel-button w-full bg-primary py-5 font-pixel text-sm text-primary-content"
    >
      DOCK
    </button>
  </.form>

  <a
    href="https://voyager.swmansion.com"
    class="voyager-button flex items-center justify-between gap-4 px-4 py-3"
  >
    <Sprites.voyager_logo class="h-7" />
    <span class="text-base">What is Voyager?</span>
  </a>

  <footer class="mt-auto flex flex-col gap-2 pt-4 font-mono text-[11px] text-base-content/45">
    <div class="flex items-center justify-between gap-4">
      <span>DOCKED {@docked}/{@capacity}</span>
      <.link navigate={~p"/tv"} class="underline hover:text-primary">Station Ops screen</.link>
    </div>
  </footer>
</div>
